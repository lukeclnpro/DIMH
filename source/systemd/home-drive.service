[Unit]
Description=HomeDrive personal NAS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/home-drive
ExecStart=/opt/home-drive/.venv/bin/python -m uvicorn server.main:app --host 0.0.0.0 --port 8000
Restart=on-failure

[Install]
WantedBy=multi-user.target
